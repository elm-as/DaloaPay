# ========================================
# DaloaPay — Modèle Variables d'environnement
# ========================================
PORT=3000
NODE_ENV=production

# URLs
SITE_URL=https://daloamarket.com
PUBLIC_API_URL=https://api.daloamarket.com

# Supabase
SUPABASE_URL=https://<votre-projet>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Push VAPID
VAPID_PUBLIC_KEY=votre-cle-publique-vapid
VAPID_PRIVATE_KEY=votre-cle-privee-vapid
VAPID_SUBJECT=mailto:contact@daloamarket.com

# Secrets Administration & Webhooks
ADMIN_SECRET=votre-secret-admin
PUSH_WEBHOOK_SECRET=votre-secret-push
PAYOUT_WEBHOOK_SECRET=votre-secret-payout

# Paiements
PAYMENT_PROVIDER=moneyfusion
FUSION_API_URL=https://pay.moneyfusion.net/paiement/
MONEYFUSION_PRIVATE_KEY=

# SasPay
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
